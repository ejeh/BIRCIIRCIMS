[
  {
    "name": "Send Notification (Admin)",
    "description": "Creates and delivers a notification. Requires GLOBAL_ADMIN, SUPPORT_ADMIN or ADMIN role. Can target a single user, all users, users by role, or users by LGA of residence. Recipients receive a real-time WebSocket push via the 'notification:new' event and an updated unread count via 'notification:unread'.",
    "controller": "NotificationsController",
    "methodName": "sendNotification",
    "httpMethod": "POST",
    "endpoint": "",
    "fullUrl": "/api/notifications",
    "authentication": {
      "required": true,
      "guards": ["JwtAuthGuard", "RolesGuard"],
      "roles": ["GLOBAL_ADMIN", "SUPPORT_ADMIN", "ADMIN"],
      "bearerToken": true
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "pathParams": {},
    "queryParams": {},
    "requestPayload": {
      "title": "string (required)",
      "message": "string (required)",
      "type": "string (optional, one of: general, idcard, certificate, system, alert, auctioneer, payment, receipt; default: general)",
      "link": "string (optional, frontend route the notification links to)",
      "target": "string (optional, one of: user, all, role, lga; default: user)",
      "userId": "string (optional, MongoId, required when target is 'user')",
      "lga": "string (optional, required when target is 'lga', matches user lgaOfResidence)",
      "roles": "string[] (optional, roles to target when target is 'role'; default: ['user'])"
    },
    "requestExample": {
      "title": "Certificate approved",
      "message": "Your certificate of origin has been approved.",
      "type": "certificate",
      "link": "/certificates/64a1b2c3d4e5f6a7b8c9d0e1",
      "target": "role",
      "roles": ["user"]
    },
    "multipart": {
      "enabled": false,
      "files": [],
      "fields": {}
    },
    "validation": [
      "title: @IsString, @IsNotEmpty (required)",
      "message: @IsString, @IsNotEmpty (required)",
      "type: @IsOptional, @IsString",
      "link: @IsOptional, @IsString",
      "target: @IsOptional, @IsEnum(NotificationTarget)",
      "userId: @IsOptional, @IsMongoId",
      "lga: @IsOptional, @IsString",
      "roles: @IsOptional, @IsArray, @IsString({ each: true })"
    ],
    "successResponse": {
      "statusCode": 201,
      "message": "Notification sent to N recipient(s)",
      "data": {
        "success": "boolean",
        "message": "string",
        "delivered": "number",
        "data": "Notification[]"
      }
    },
    "successExample": {
      "success": true,
      "message": "Notification sent to 3 recipient(s)",
      "delivered": 3,
      "data": [
        {
          "_id": "64a1b2c3d4e5f6a7b8c9d0e1",
          "userId": "64a1b2c3d4e5f6a7b8c9d0e2",
          "title": "Certificate approved",
          "message": "Your certificate of origin has been approved.",
          "type": "certificate",
          "read": false,
          "link": "/certificates/64a1b2c3d4e5f6a7b8c9d0e1",
          "lga": "Aba South",
          "createdAt": "2024-06-20T14:30:00.000Z",
          "updatedAt": "2024-06-20T14:30:00.000Z",
          "expiresAt": "2024-07-20T14:30:00.000Z"
        }
      ]
    },
    "errorResponses": [
      {
        "statusCode": 400,
        "message": "userId is required when target is \"user\"",
        "description": "Returned when target is user but no userId is supplied"
      },
      {
        "statusCode": 400,
        "message": "lga is required when target is \"lga\"",
        "description": "Returned when target is lga but no lga is supplied"
      },
      {
        "statusCode": 403,
        "message": "User does not have require permission",
        "description": "Returned when the authenticated user does not have an admin role"
      },
      {
        "statusCode": 401,
        "message": "Unauthorized",
        "description": "Returned when no valid JWT token is provided"
      }
    ]
  },
