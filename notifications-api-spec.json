  {
    "name": "WebSocket Events",
    "description": "Real-time notification push events emitted by the NotificationsGateway over Socket.IO. Connect with a socket.io client, passing the JWT in the handshake as `Authorization: Bearer <token>`. The server emits these events to the authenticated user's socket only.",
    "controller": "NotificationsGateway",
    "methodName": "socket.io",
    "httpMethod": "WS",
    "endpoint": "/",
    "fullUrl": "socket.io (io.connect) with auth header",
    "websocket": true,
    "authentication": {
      "required": true,
      "guards": [],
      "roles": [],
      "bearerToken": true
    },
    "headers": {
      "Authorization": "Bearer <token> (handshake header)"
    },
    "pathParams": {},
    "queryParams": {},
    "requestPayload": {},
    "requestExample": {
      "connection": "io('http://<host>:<port>', { transportOptions: { polling: { extraHeaders: { Authorization: 'Bearer <token>' } } } })"
    },
    "multipart": {
      "enabled": false,
      "files": [],
      "fields": {}
    },
    "validation": [],
    "successResponse": {
      "statusCode": 200,
      "message": "",
      "data": {
        "notification:new": "Emitted when a new notification is created for the user. Payload is the full Notification document.",
        "notification:unread": "Emitted when the user's unread count changes (mark read, mark all read, delete, clear, new notification). Payload is { unreadCount: number }"
      }
    },
    "successExample": {
      "event": "notification:new",
      "payload": {
        "_id": "64a1b2c3d4e5f6a7b8c9d0e1",
        "userId": "64a1b2c3d4e5f6a7b8c9d0e2",
        "title": "Certificate approved",
        "message": "Your certificate of origin has been approved.",
        "type": "certificate",
        "read": false,
        "link": "/certificates/64a1b2c3d4e5f6a7b8c9d0e1",
        "lga": null,
        "createdAt": "2024-06-20T14:30:00.000Z",
        "updatedAt": "2024-06-20T14:30:00.000Z",
        "expiresAt": "2024-07-20T14:30:00.000Z"
      },
      "unreadEvent": {
        "event": "notification:unread",
        "payload": {
          "unreadCount": 4
        }
      }
    },
    "errorResponses": [
      {
        "statusCode": 401,
        "message": "Disconnected",
        "description": "The server disconnects the socket when no token is provided or the token is invalid"
      }
