    },
    "pathParams": {
      "id": ":id"
    },
    "queryParams": {},
    "requestPayload": {
      "userId": "687ad12ab5... (string, optional)",
      "name": "John Doe (string, optional)",
      "email": "john.doe@example.com (string, optional)",
      "phone": "08012345678 (string, optional)",
      "NIN": "12345678901 (string, optional)",
      "address": "123 Main St (string, optional)",
      "LGA": "Gboko (string, optional)",
      "state": "Benue (string, optional)",
      "gender": "Male | Female (enum, optional)",
      "taxClearance": "file (optional, replaces existing, PDF or image, max 5MB)"
    },
    "requestExample": {
      "address": "456 New St",
      "phone": "08098765432",
      "taxClearance": "(file upload, optional)"
    },
    "multipart": {
      "enabled": true,
      "files": [
        {
          "fieldName": "taxClearance",
          "type": "application/pdf, image/jpeg, image/png, image/jpg",
          "extensions": [".pdf", ".jpeg", ".jpg", ".png"],
          "maxSize": "5MB",
          "required": false
        }
      ],
      "fields": {}
    },
    "validation": [
      "userId: @IsString, optional",
      "name: @IsString, optional",
      "email: @IsString, optional",
      "phone: @IsString, optional",
      "NIN: @IsString, optional",
      "address: @IsString, optional",
      "LGA: @IsString, optional",
      "state: @IsString, optional",
      "gender: @IsEnum(Gender ['Male','Female']), optional",
      "taxClearance: @IsString, optional (file)",
      "Business rule: Request must belong to the authenticated user",
      "Business rule: Status must be 'Pending' or 'Rejected'",
      "Business rule: Cannot edit a request that is already approved or processed"
