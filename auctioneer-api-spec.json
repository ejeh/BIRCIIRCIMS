[
  {
    "name": "Create Auctioneer License Request",
    "description": "Creates a new auctioneer license request. Requires multipart/form-data with the taxClearance file (PDF or image, max 5MB) uploaded to Cloudinary (folder: certificates/tax_clearance). License reference data is auto-generated (licenceRefNumber e.g. 'BNT 1', formattedNumber e.g. '0001'). Throws if the user already has a Pending request or an Approved request with pending payment.",
    "controller": "AuctioneerController",
    "methodName": "createAuctioneer",
    "httpMethod": "POST",
    "endpoint": "create",
    "fullUrl": "/api/auctioneer/create",
    "authentication": {
      "required": true,
      "guards": ["JwtAuthGuard"],
      "roles": [],
      "bearerToken": true
    },
    "headers": {
      "Authorization": "Bearer <token>",
      "Content-Type": "multipart/form-data"
    },
    "pathParams": {},
    "queryParams": {},
    "requestPayload": {
      "userId": "687ad12ab5... (string, required)",
      "name": "John Doe (string, required)",
      "email": "john.doe@example.com (string, required, unique)",
      "phone": "08012345678 (string, required)",
      "NIN": "12345678901 (string, required, unique)",
      "address": "123 Main St (string, required)",
      "LGA": "Gboko (string, required)",
      "state": "Benue (string, required)",
      "gender": "Male | Female (enum, required)",
      "taxClearance": "file (required, PDF or image, max 5MB)"
    },
    "requestExample": {
      "userId": "687ad12ab5...",
      "name": "John Doe",
      "email": "john.doe@example.com",
      "phone": "08012345678",
      "NIN": "12345678901",
      "address": "123 Main St",
      "LGA": "Gboko",
      "state": "Benue",
      "gender": "Male",
      "taxClearance": "(file upload)"
    },
    "multipart": {
      "enabled": true,
      "files": [
        {
          "fieldName": "taxClearance",
          "type": "application/pdf, image/jpeg, image/png, image/jpg",
          "extensions": [".pdf", ".jpeg", ".jpg", ".png"],
          "maxSize": "5MB",
          "required": true
        }
      ],
      "fields": {}
    },
    "validation": [
      "userId: @IsNotEmpty, @IsString, required",
      "name: @IsNotEmpty, @IsString, required",
      "email: @IsNotEmpty, @IsString, required, unique",
      "phone: @IsNotEmpty, @IsString, required",
      "NIN: @IsNotEmpty, @IsString, required, unique",
      "address: @IsNotEmpty, @IsString, required",
      "LGA: @IsNotEmpty, @IsString, required",
      "state: @IsNotEmpty, @IsString, required",
      "gender: @IsNotEmpty, @IsEnum(Gender ['Male','Female']), required",
      "taxClearance: @IsOptional, @IsString, must be PDF/Image (file filter)",
      "Business rule: User must not have an existing Pending auctioneer request",
      "Business rule: User must not have an Approved request with pending payment"
    ],
    "successResponse": {
      "statusCode": 201,
      "message": "Auctioneer license request created",
      "data": {
        "_id": "687ad12ab5...",
        "userId": "687ad12ab5...",
        "name": "John Doe",
        "email": "john.doe@example.com",
        "phone": "08012345678",
        "NIN": "12345678901",
        "address": "123 Main St",
        "LGA": "Gboko",
        "state": "Benue",
        "gender": "Male",
        "taxClearance": "https://res.cloudinary.com/.../certificates/tax_clearance/xxx.pdf",
        "status": "Pending",
        "licenceRefSequence": 1,
