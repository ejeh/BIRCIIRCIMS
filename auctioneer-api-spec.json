  {
    "name": "Update Auctioneer License Request",
    "description": "Updates an existing auctioneer license request owned by the authenticated user. Supports multipart/form-data for an optional taxClearance file replacement (PDF or image, max 5MB). Only allowed when the request status is Pending or Rejected. License reference numbers are NOT regenerated on update.",
    "controller": "AuctioneerController",
    "methodName": "updateAuctioneer",
    "httpMethod": "PATCH",
    "endpoint": ":id",
    "fullUrl": "/api/auctioneer/:id",
    "authentication": {
      "required": true,
      "guards": ["JwtAuthGuard"],
      "roles": [],
      "bearerToken": true
    },
